# Copy to deploy/htpasswd and replace with your own credential:
#   htpasswd -bc deploy/htpasswd boss 'choose-a-password'
# (Debian/Ubuntu: apt install apache2-utils. macOS: htpasswd ships with Apache.)
# Or without htpasswd installed:
#   docker run --rm httpd:alpine htpasswd -nb boss 'choose-a-password' > deploy/htpasswd
boss:$apr1$EXAMPLE$REPLACE.THIS.WITH.A.REAL.HASH
