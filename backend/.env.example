# ===== LLM provider — "gemini" (default) หรือ "openrouter" =====
# LLM_PROVIDER=gemini

# ===== Provider 1: Gemini (default) =====
# วิธีที่ 1: ใช้ GCP Service Account Key (แนะนำ)
GCP_CREDENTIALS_PATH=../.gcp/key.json

# วิธีที่ 2: ใช้ Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini config
# GCP_PROJECT_ID=your-project-id
# GCP_LOCATION=asia-southeast1
# GEMINI_MODEL=gemini-2.0-flash

# ===== Provider 2: OpenRouter (set LLM_PROVIDER=openrouter to use) =====
# สมัคร key ที่ https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# จาก benchmark (2026-04): gemini-3-flash-preview = sweet spot
#   - แม่นเทียบเท่า gemini-3.1-pro / claude-opus-4.7 (score 0.945)
#   - เร็ว 7s, ราคา ~$0.005/doc (ถูกกว่า pro 10x, ถูกกว่า opus 25x)
# ทางเลือกอื่น: google/gemini-3.1-pro-preview, anthropic/claude-opus-4.7
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_TITLE=Thai Receipt Intelligence
# OPENROUTER_APP_URL=https://your-app.example.com  # optional, สำหรับ leaderboard

# ===== Database =====
# DATABASE_URL=sqlite:///./data/receipts.db

# ===== Storage =====
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE_MB=20

# ===== CORS (comma-separated origins) =====
# CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== Logging =====
# LOG_LEVEL=INFO

# ===== Gemini Retry =====
# GEMINI_MAX_RETRIES=3
# GEMINI_RETRY_DELAY=1.0

# ===== OCR (PaddleOCR) =====
# OCR_ENABLED=true
# OCR_LANG=th

# ===== Web Push Notifications (VAPID) =====
# Generate with: cd backend && .venv/bin/python -m app.scripts.gen_vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
