# ===== OpenRouter (LLM gateway) =====
# สมัคร key ที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# จาก benchmark (2026-09, 32 ใบ / 145 บรรทัด — scripts/sweep_models.py):
#   gemini-3.1-flash-lite = คุ้มที่สุด p50 2.9s, ~$0.0027/ใบ
#   3.5-flash-lite / 3-flash-preview / 3.6 / 3.7 / 3.8-flash แม่นเท่ากัน
#   (ต่างกันไม่เกิน 1 บรรทัด = noise) แต่ช้ากว่า 2-5x และแพงกว่า 2-20x
# ห้ามตั้งเป็น preview เป็นค่าหลัก — ถูกถอดได้โดยไม่แจ้งล่วงหน้า
# รายชื่อสำรอง ถ้าตัวหลักถูกถอด OpenRouter จะสลับให้เอง (คั่นด้วย comma)
# OPENROUTER_FALLBACK_MODELS=google/gemini-3.5-flash-lite,google/gemini-3-flash-preview
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_TITLE=Thai Receipt Intelligence
# OPENROUTER_APP_URL=https://your-app.example.com  # optional, สำหรับ leaderboard

# ===== Database =====
# DATABASE_URL=sqlite:///./data/receipts.db

# ===== Storage =====
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE_MB=20

# ===== CORS (comma-separated origins) =====
# CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== Logging =====
# LOG_LEVEL=INFO

# ===== LLM Retry =====
# LLM_MAX_RETRIES=3
# LLM_RETRY_DELAY=1.0
# LLM_REQUEST_TIMEOUT=60.0

# ===== Concurrency =====
# Concurrent extractions in BackgroundTasks fallback (USE_ARQ=false).
# Bump for bulk-upload demos; lower if you hit OpenRouter rate limits.
# EXTRACTION_CONCURRENCY=4
