# ===== เลือกวิธี auth อย่างใดอย่างหนึ่ง =====

# วิธีที่ 1: ใช้ GCP Service Account Key (แนะนำ)
GCP_CREDENTIALS_PATH=../.gcp/key.json

# วิธีที่ 2: ใช้ Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# ===== Optional =====
# GCP_PROJECT_ID=your-project-id
# GCP_LOCATION=asia-southeast1
# GEMINI_MODEL=gemini-2.0-flash

# ===== Database =====
# DATABASE_URL=sqlite:///./data/receipts.db

# ===== Storage =====
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE_MB=20

# ===== CORS (comma-separated origins) =====
# CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== Logging =====
# LOG_LEVEL=INFO

# ===== Gemini Retry =====
# GEMINI_MAX_RETRIES=3
# GEMINI_RETRY_DELAY=1.0

# ===== OCR (PaddleOCR) =====
# OCR_ENABLED=true
# OCR_LANG=th

# ===== Web Push Notifications (VAPID) =====
# Generate with: cd backend && .venv/bin/python -m app.scripts.gen_vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
