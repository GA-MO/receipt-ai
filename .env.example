# docker compose reads THIS file (repo root) for ${...} interpolation in
# docker-compose.yml. backend/.env is a different file: it is injected into the
# containers via env_file and holds OPENROUTER_API_KEY.
#
# Nothing is interpolated at the moment — the stack runs without a broker — so
# this file can stay empty. Set REDIS_PASSWORD here if you switch USE_ARQ back
# on and re-add the redis service.
